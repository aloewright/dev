# /etc/systemd/system/hindsight.service — brings the compose stack up on boot.
# Install: sudo systemctl daemon-reload && sudo systemctl enable --now hindsight.service
[Unit]
Description=Hindsight docker compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hindsight
EnvironmentFile=/opt/hindsight/.env
ExecStart=/usr/bin/docker compose up -d --pull always
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
